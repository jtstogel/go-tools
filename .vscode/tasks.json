{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start iBazel (rust)",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/rust/ibazel_rust.sh",
      "args": [],
      "isBackground": true,
      "problemMatcher": [
        {
          "base": "$rustc",
          "owner": "rustc-bazel",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^INFO: Analyzed \\d+ targets.*",
            "endsPattern": "^(INFO: Build completed successfully.*|ERROR: Build did NOT complete successfully)$"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Generate rust-project.json",
      "type": "shell",
      "command": "bazel",
      "options": { "cwd": "${workspaceFolder}" },
      "args": ["run", "@rules_rust//tools/rust_analyzer:gen_rust_project"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}